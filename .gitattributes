# T-01: Unity text assets and code are LF everywhere — the author's PC has core.autocrlf=true, and CRLF copies
# made every settings file look changed (2026-10-07).
*.cs      text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.unity   text eol=lf
*.prefab  text eol=lf
*.mat     text eol=lf
*.asmdef  text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.md      text eol=lf
